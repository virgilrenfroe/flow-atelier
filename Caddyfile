{
	auto_https off
	admin off
}
:{$PORT:8080} {
	root * /srv
	encode gzip

	# Static assets must 404 when missing. SPA fallback would serve index.html
	# as text/html, which breaks Open Graph crawlers fetching /og.jpg.
	@static path *.jpg *.jpeg *.png *.webp *.gif *.ico *.css *.js *.map *.woff2 *.mp3 *.mp4 *.wasm *.json
	handle @static {
		file_server
	}

	handle {
		try_files {path} {path}.html {path}/ /index.html
		file_server
	}
}
